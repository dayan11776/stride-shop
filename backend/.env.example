# Django / Render
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-service.onrender.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app

# PayMongo Hosted Checkout — keep these in Render variables; never prefix them with VITE_
# Test keys use sk_test_..., live keys use sk_live_.... The webhook secret is
# shown when you create the endpoint in PayMongo, and is not the API key.
PAYMENT_PROVIDER=paymongo
PAYMONGO_SECRET_KEY=sk_test_...
PAYMONGO_WEBHOOK_SECRET=replace-with-the-webhook-signing-secret
PAYMONGO_SUCCESS_REDIRECT_URL=https://your-project.vercel.app/order-confirmation/{order_number}
PAYMONGO_CANCEL_REDIRECT_URL=https://your-project.vercel.app/checkout
PAYMONGO_PAYMENT_METHOD_TYPES=card,gcash,qrph
PAYMONGO_SEND_EMAIL_RECEIPT=true

# Optional legacy Xendit fallback — keep these in Render variables if required.
XENDIT_SECRET_KEY=xnd_development_...
XENDIT_WEBHOOK_TOKEN=replace-with-the-callback-token
XENDIT_SUCCESS_REDIRECT_URL=https://your-project.vercel.app/order-confirmation/{order_number}
XENDIT_FAILURE_REDIRECT_URL=https://your-project.vercel.app/checkout

